# Copy this file to .env and fill in real values. Never commit .env.

# This was the Supabase Postgres connection string.
# For local dev, the direct connection string worked, found under
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
# For production on Vercel, the Transaction pooler string (port 6543) was used
# instead, so each function call could reuse a pooled connection.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# This was for the local dev server only. Production used its own port, set by Vercel.
PORT=5000
