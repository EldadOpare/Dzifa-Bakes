# Copy this to .env and fill in your real values. Don't commit .env.

# Your Supabase Postgres connection string.
# For local dev, use the direct string (Project Settings -> Database -> Connection string).
# For production on Vercel, use the Transaction pooler string (port 6543) instead.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Your Supabase project URL and anon (public) key, for staff login.
# Both found under Project Settings -> API. The anon key is safe to expose
# in the browser, that's what it's for.
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# This one is a real secret. Never put VITE_ in front of it, never send it
# to the browser. Found under Project Settings -> API -> service_role key.
# Only used server-side, to upload photos into storage.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Local dev server port only. Vercel sets its own port in production.
PORT=5000
